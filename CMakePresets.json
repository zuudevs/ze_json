{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_CXX_STANDARD": "23",
				"CMAKE_CXX_STANDARD_REQUIRED": "ON",
				"CMAKE_CXX_EXTENSIONS": "OFF",
				"CMAKE_CXX_FLAGS": "-Wno-c2y-extensions",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		}, {
			"name": "native",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
			}
		}, {
			"name": "wasm",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_SYSTEM_NAME": "Generic",
                "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
			}
		}, {
			"name": "wasm64",
			"inherits": "wasm",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER_TARGET": "wasm64",
                "CMAKE_CXX_COMPILER_TARGET": "wasm64",
                "CMAKE_SYSTEM_PROCESSOR": "wasm64"
			}
		}, {
			"name": "wasm32",
			"inherits": "wasm",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER_TARGET": "wasm32",
                "CMAKE_CXX_COMPILER_TARGET": "wasm32",
                "CMAKE_SYSTEM_PROCESSOR": "wasm32"
			}
		}, {
			"name": "native-debug",
			"inherits": "base",
			"displayName": "Native Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}, {
			"name": "native-release",
			"inherits": "base",
			"displayName": "Native Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}, {
			"name": "wasm32-debug",
			"inherits": "wasm32",
			"displayName": "WASM x32 Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}, {
			"name": "wasm32-release",
			"inherits": "wasm32",
			"displayName": "WASM x32 Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}, {
			"name": "wasm64-debug",
			"inherits": "wasm64",
			"displayName": "WASM x64 Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}, {
			"name": "wasm64-release",
			"inherits": "wasm64",
			"displayName": "WASM x64 Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets": [
		{
			"name": "native-debug",
			"configurePreset": "native-debug"
		}, {
			"name": "native-release",
			"configurePreset": "native-release"
		},
		{
			"name": "wasm32-debug",
			"configurePreset": "wasm32-debug"
		}, {
			"name": "wasm32-release",
			"configurePreset": "wasm32-release"
		},
		{
			"name": "wasm64-debug",
			"configurePreset": "wasm64-debug"
		}, {
			"name": "wasm64-release",
			"configurePreset": "wasm64-release"
		}
	]
}