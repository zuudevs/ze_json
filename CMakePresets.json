{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CXX_STANDARD": "23",
				"CMAKE_CXX_STANDARD_REQUIRED": "ON",
				"CMAKE_CXX_EXTENSIONS": "OFF",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"CMAKE_CXX_FLAGS": "-Wno-c2y-extensions"
			}
		},
		{
			"name": "native",
			"inherits": "base",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../.toolchains/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/modules/toolchain.cmake"
			}
		},
		{
			"name": "wasm",
			"inherits": "base",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/modules/toolchain.cmake",
				"CMAKE_SYSTEM_NAME": "Generic",
				"CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
			}
		},
		{
			"name": "wasm64",
			"inherits": "wasm",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_SYSTEM_PROCESSOR": "wasm64"
			}
		},
		{
			"name": "wasm32",
			"inherits": "wasm",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_SYSTEM_PROCESSOR": "wasm32"
			}
		},
		{
			"name": "native-debug",
			"inherits": "native",
			"displayName": "Native Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "native-release",
			"inherits": "native",
			"displayName": "Native Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "native-release-with-debug-info",
			"inherits": "native",
			"displayName": "Native Release with debug info",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "native-sanitize",
			"inherits": "native",
			"displayName": "Native Sanitize (ASan + UBSan)",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"ENABLE_SANITIZERS": "ON"
			}
		},
		{
			"name": "native-pgo",
			"inherits": "native",
			"displayName": "Native PGO",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"ENABLE_PGO": "ON",
				"ENABLE_TARGET_OPTIMIZATIONS": "ON"
			}
		},
		{
			"name": "native-release-march",
			"inherits": "native",
			"displayName": "Native Release with -march=native (local labeled builds only)",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"ENABLE_TARGET_OPTIMIZATIONS": "ON",
				"ENABLE_MARCH_NATIVE": "ON"
			}
		},
		{
			"name": "native-release-ipo",
			"inherits": "native",
			"displayName": "Native Release with LTO (E3 experiment; local labeled builds only)",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"ENABLE_TARGET_OPTIMIZATIONS": "ON",
				"ENABLE_IPO": "ON"
			}
		},
		{
			"name": "wasm32-debug",
			"inherits": "wasm32",
			"displayName": "WASM x32 Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "wasm32-release-with-debug-info",
			"inherits": "wasm32",
			"displayName": "WASM x32 Release with debug info",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "wasm32-release",
			"inherits": "wasm32",
			"displayName": "WASM x32 Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "wasm64-debug",
			"inherits": "wasm64",
			"displayName": "WASM x64 Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "wasm64-release-with-debug-info",
			"inherits": "wasm64",
			"displayName": "WASM x64 Release with debug info",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "wasm64-release",
			"inherits": "wasm64",
			"displayName": "WASM x64 Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets": [
		{
			"name": "native-debug",
			"configurePreset": "native-debug"
		},
		{
			"name": "native-release-with-debug-info",
			"configurePreset": "native-release-with-debug-info"
		},
		{
			"name": "native-release",
			"configurePreset": "native-release"
		},
		{
			"name": "native-sanitize",
			"configurePreset": "native-sanitize"
		},
		{
			"name": "native-pgo",
			"configurePreset": "native-pgo"
		},
		{
			"name": "native-release-ipo",
			"configurePreset": "native-release-ipo"
		},
		{
			"name": "wasm32-debug",
			"configurePreset": "wasm32-debug"
		},
		{
			"name": "wasm32-release",
			"configurePreset": "wasm32-release"
		},
		{
			"name": "wasm32-release-with-debug-info",
			"configurePreset": "wasm32-release-with-debug-info"
		},
		{
			"name": "wasm64-debug",
			"configurePreset": "wasm64-debug"
		},
		{
			"name": "wasm64-release-with-debug-info",
			"configurePreset": "wasm64-release-with-debug-info"
		},
		{
			"name": "wasm64-release",
			"configurePreset": "wasm64-release"
		}
	]
}