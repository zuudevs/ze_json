# Submodule samples (korpus benchmark & roundtrip ~61 MB) — distribusi
# terpisah via https://github.com/zuudevs/ze_json_sample ; konten submodule
# TIDAK di-ignore (terlacak sebagai gitlink).

# Build output directories
/build/
/bin/
/lib/
.cache/

# CMake generated files & caches
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Python Generated files & caches
__pycache__/

# vcpkg
/vcpkg_installed/
vcpkg.log

# npm pack hasil prepack — binary .wasm disalin ke js/ saat publish
js/ze_json_core.wasm

# Node — devDependency benchmark.js (hanya dipakai js/benchmark; bukan runtime)
node_modules/

# IDE & Editor files
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosv
*.sln.docstates

# Coverage & Profiling
*.profraw
*.profdata
*.gcov
*.gcda
*.gcno
/coverage/

# Python — venv lokal untuk scripts/results_analysis.py
.venv/

# Hasil analisis (scripts/results_analysis.py) — turunan artefak, regenerable
/out/analysis/

# OS & Temporary files
.DS_Store
Thumbs.db
*.tmp
*.swp
*~