"""ValidateVersion — configure-time generated (version registry, PLANS).

Checks BOTH registries against their single sources of truth:
  vcpkg.json            "version"      == core semver (CMake project VERSION)
  bindings/js/package.json "version"   == ZE_JSON_JS_VERSION (ModuleRegistry)

The bindings package.json is REGENERATED from package.json.in at configure
time (Dependencies.cmake) with ZE_JSON_JS_VERSION + coreVersion/coreSemver,
so a mismatch here means a hand-edited or stale file — fail loud.
"""
from pathlib import Path
import re

CORE_SEMVER = '@CMAKE_PROJECT_VERSION@'
JS_VERSION = '@ZE_JSON_JS_VERSION@'
VCPKG_JSON_PATH = Path('@CMAKE_SOURCE_DIR@').resolve() / 'vcpkg.json'
PACKAGE_JSON_PATH = Path('@CMAKE_SOURCE_DIR@').resolve() / 'bindings' / 'js' / 'package.json'


def read_version(path: Path) -> str | None:
    with open(path, 'r', encoding='utf-8') as r:
        matched = re.search(r'\s+"version":\s*"(\d+\.\d+\.\d+)",', r.read())
        return matched.group(1) if matched else None


def main():
    failures = []
    vcpkg_version = read_version(VCPKG_JSON_PATH)
    if vcpkg_version == CORE_SEMVER:
        print(f'[+] vcpkg version match! ({CORE_SEMVER})')
    else:
        failures.append(
            f'vcpkg.json version {vcpkg_version!r} != core semver {CORE_SEMVER!r}')

    pkg_version = read_version(PACKAGE_JSON_PATH)
    if pkg_version == JS_VERSION:
        print(f'[+] bindings package.json version match! ({JS_VERSION})')
    else:
        failures.append(
            f'bindings/js/package.json version {pkg_version!r} != '
            f'ZE_JSON_JS_VERSION {JS_VERSION!r}')

    if failures:
        for f in failures:
            print(f'[-] {f}')
        raise SystemExit(1)


if __name__ == '__main__':
    main()
